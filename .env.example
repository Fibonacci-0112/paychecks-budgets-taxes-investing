# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Two categories below, and the distinction matters:
#
#   Endpoints are public. Every client binary contains them, so they are
#   committed here as real values rather than placeholders.
#
#   Keys and tokens are secret. They live only in `.env`, and nothing in this
#   file should ever be replaced with a real one.

# ---------------------------------------------------------------- PowerSync

# The sync service endpoint. Public: clients connect directly to it.
POWERSYNC_URL=https://6aa765b402481fb31b96554d.powersync.journeyapps.com

# ------------------------------------------------------------------ Supabase

# Project reference and API URL. Public.
SUPABASE_PROJECT_REF=bkrrnjllkdvnrrmiwyfs
SUPABASE_URL=https://bkrrnjllkdvnrrmiwyfs.supabase.co

# Publishable/anon key. Safe to ship in a client *only* because row-level
# security is enforced on every table — see supabase/migrations/. It is still
# kept out of git so a key rotation is not a code change.
SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security entirely, so it must never
# reach a client bundle, a browser, or this repository.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for applying migrations:
#   psql "$DATABASE_URL" -f supabase/migrations/0001_core_ledger.sql
# Do NOT apply supabase/ci/00_bootstrap.sql to a real project — that is a local
# shim for auth.uid() and the anon/authenticated roles, which Supabase already
# provides, and applying it would overwrite platform functions.
DATABASE_URL=
